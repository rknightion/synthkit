# synthkit configuration — copy to .env and fill in. DRY_RUN defaults to TRUE:
# pushing live is always an explicit opt-in (set DRY_RUN=false).
#
# IMPORTANT: keep comments on their OWN line. Docker Compose's env_file does NOT strip inline
# `value # comment` (it becomes part of the value) — so never put a comment after a value here.

# ── Synthetic data sinks ──
# One CAP token (metrics:write, logs:write, traces:write, profiles:write) covers all synthetic sinks.
# GC_PROM_RW e.g. https://prometheus-prod-XX-<region>.grafana.net/api/prom/push  (GC_PROM_USER = Mimir id)
# GC_OTLP_ENDPOINT e.g. https://otlp-gateway-<region>.grafana.net/otlp           (GC_OTLP_USER = stack id)
# GC_LOKI e.g. https://logs-prod-XXX.grafana.net/loki/api/v1/push                (GC_LOKI_USER = Loki id)
GC_TOKEN=
GC_PROM_RW=
GC_PROM_USER=
GC_OTLP_ENDPOINT=
GC_OTLP_USER=
GC_LOKI=
GC_LOKI_USER=
# Synthetic profiles require a selected workload profile declaration plus GC_TOKEN and both
# customer-profile fields below. They are separate from synthkit process profiling above.
GC_PROFILES_URL=
GC_PROFILES_USER=

# Optional — Faro/RUM requires a selected app/web_service RUM declaration, both fields below, and
# a live synthetic run. Verify a fresh Faro delivery; credentials alone leave the lane partial.
# GC_FARO_COLLECTOR e.g. https://faro-collector-<region>.grafana.net/collect/<app-key>
GC_FARO_COLLECTOR=
GC_FARO_APP_KEY=

# ── Behaviour ──
# DRY_RUN: flip to false to push live. TICK_DEFAULT: master-clock cadence. MAX_DPM_PER_SERIES:
# ceiling for an explicit per-blueprint high_dpm override (default 6). SERIES_CAP: optional
# global per-push series backstop (empty = unlimited). BLUEPRINTS: dir containing bundled YAML.
# BLUEPRINT_NAMES: runtime selection. Empty = setup mode (emit nothing); comma-separated exact names
# load only those blueprints; * is the explicit opt-in to load the complete available catalog.
# JSON_HTTP_ADDR: the address the app BINDS for the control plane + Infinity JSON host
# (/control/ui for the operator UI). Direct runs bind to loopback by default. Docker Compose
# overrides this to 0.0.0.0:8088 only inside its container so port mapping works; host exposure
# remains restricted separately by SYNTHKIT_BIND (below). When CONTROL_TOKEN is set, it protects
# sensitive control reads, every Infinity data route, and mutations; probes remain public.
DRY_RUN=true
TICK_DEFAULT=5s
MAX_DPM_PER_SERIES=6
SERIES_CAP=
BLUEPRINTS=./blueprints
BLUEPRINT_NAMES=
JSON_HTTP_ADDR=127.0.0.1:8088
CONFIG_SNAPSHOT_PATH=./control-state.json
# CONTROL_TOKEN: HTTP Basic password (username "control") for sensitive control/Infinity reads and
# all mutations. Empty is supported only for loopback exposure.
CONTROL_TOKEN=
# Required only when the effective host bind is non-loopback. Exact values: trusted-network when
# plaintext HTTP stays on an isolated trusted path, or tls-proxy when a trusted proxy terminates TLS.
CONTROL_EXPOSURE_ACK=
# TICK_TIMEOUT: optional per-blueprint per-tick backstop in seconds. Empty/0 = disabled (the per-sink
# 15s HTTP timeouts already bound hung pushes); set >0 only as a coarse whole-tick safety net.
TICK_TIMEOUT=

# ── External / custom blueprint sources ──
# Persisted staging dir for custom/git blueprints (under the /data volume in compose).
BLUEPRINT_DATA_DIR=./data/blueprints
# Git source poll interval in seconds for "update available" detection (0 = off, detect-and-notify only).
GIT_POLL_INTERVAL=0
# Default git token (HTTPS PAT) for private blueprint repos whose source config leaves token_env_var
# empty; leave blank for public repos. A private source additionally needs a successful fetch and
# applied revision. Per-source token variable names are operator-defined and not tracked here.
GIT_TOKEN=

# ── Decoupled delivery queue (internal/sink/queue) ──
# SEND_SHARDS: parallel shard workers per sink (default 8).
SEND_SHARDS=8
# SEND_BATCH_MAX: max series per flush batch (default 5000).
SEND_BATCH_MAX=5000
# SEND_BATCH_DEADLINE: max age before a partial batch is flushed (Go duration; default 5s).
SEND_BATCH_DEADLINE=5s
# SEND_QUEUE_CAPACITY: ring-buffer depth in series slots before backpressure (default 500000;
# burst headroom for many simultaneous clusters — RAM is consumed only when the buffer actually
# fills under backpressure, so this is cheap headroom; raise further for very high cluster counts).
SEND_QUEUE_CAPACITY=500000
# SEND_DRAIN_DEADLINE: graceful-shutdown drain budget (Go duration; default 30s).
SEND_DRAIN_DEADLINE=30s

# Published GHCR image tag pulled by docker-compose.yml. Compose-only (the app ignores it).
# Image tags use bare `X.Y.Z`; Git release tags carry the leading `v`. `main` and `latest` are
# mutable edge tags. Image selectors are ignored when building via docker-compose.build.yml.
# Preferred complete image identity for the verified stable release.
SYNTHKIT_IMAGE_REF=ghcr.io/rknightion/synthkit@sha256:0ddf2e621d7a0023c058d39e366de4aa00fc947ca748cf31f6a4399a2069525f
# Legacy compatibility only. Leave empty when SYNTHKIT_IMAGE_REF is set; the deployment helper
# reports the precedence explicitly and never falls back from a bad preferred reference.
SYNTHKIT_IMAGE_TAG=

# Compose-only path to the service env file. Leave `.env` for normal use; verification gates set
# this to a generated fake-input file so `docker compose config` never reads real credentials.
SYNTHKIT_ENV_FILE=.env

# Host interface the compose publishes :8088 on (operator UI + Infinity datasource). Compose uses it
# to publish the port, and the APP ALSO READS IT: inside a container it is the value the exposure
# gate validates, so an invalid or missing one fails startup. Default is loopback (127.0.0.1), which
# stays frictionless. Any non-loopback
# value also requires CONTROL_TOKEN plus CONTROL_EXPOSURE_ACK=trusted-network or tls-proxy; startup
# fails otherwise. Use tls-proxy with `tailscale serve` or another browser-trusted HTTPS proxy.
SYNTHKIT_BIND=127.0.0.1

# ── Self-profiling (Pyroscope) — the generator's OWN process telemetry ──
# SEPARATE data path: ships the synthkit binary's continuous profiles to a DIFFERENT Grafana Cloud
# stack via its own credential triplet (NEVER GC_TOKEN). It is just another self-obs signal, so it
# has NO master flag of its own — it follows SELFOBS_ENABLED and is independent of synthetic
# DRY_RUN. Set the complete GC_PYROSCOPE_* triplet to ship profiles; verify in the staff stack.
# GC_PYROSCOPE_URL e.g. https://profiles-prod-XXX.grafana.net (GC_PYROSCOPE_USER = Profiles instance id).
# PYROSCOPE_MUTEX_FRACTION / _BLOCK_RATE: 0 = off; 5 = high-fidelity, fine for a lab app.
GC_PYROSCOPE_URL=
GC_PYROSCOPE_USER=
GC_PYROSCOPE_PASSWORD=
PYROSCOPE_TAGS=
PYROSCOPE_MUTEX_FRACTION=5
PYROSCOPE_BLOCK_RATE=5

# ── Self-observability (OTLP) — the generator's OWN operability telemetry ──
# Push RED metrics on the synthetic pipeline + Go runtime metrics + per-tick traces + the
# operational log stream, over a SINGLE OTLP endpoint. SEPARATE data path: ships to a DIFFERENT
# stack via its own credential triplet (NEVER GC_TOKEN). Off by default; decoupled from DRY_RUN.
# GC_SELF_OTLP_ENDPOINT = base OTLP gateway URL (…/otlp); GC_SELF_OTLP_USER = the self-obs stack id.
SELFOBS_ENABLED=false
GC_SELF_OTLP_ENDPOINT=
GC_SELF_OTLP_USER=
GC_SELF_OTLP_PASSWORD=
SELFOBS_TAGS=
# GC_SELF_GRAFANA_URL = staff Grafana base URL (e.g. https://your-stack.grafana.net) — enables control-UI deep-links to the self-obs dashboard; leave empty to hide them.
GC_SELF_GRAFANA_URL=
# SELFOBS_METRIC_INTERVAL = self-obs METRIC flush cadence (Go duration; traces/logs unaffected). Default 15s.
SELFOBS_METRIC_INTERVAL=15s

# ── Synthetic Monitoring provisioner (one-shot control plane; credentials are not an emitter sink) ──
# Select an SM declaration and start synthkit once to write the exact private snapshot. On a
# Docker-only host, preview with:
#   docker compose --profile sm-provision run --rm sm-provision
# Apply only after reviewing that preview:
#   SM_PROVISION_APPLY=true docker compose --profile sm-provision run --rm sm-provision
# Then `docker compose restart synthkit`; only the matching registration activates SM emission.
# Collisions or pending/ambiguous operations hard-stop for operator review. Legacy adoption first
# records an exact private preview marker and also requires SM_PROVISION_ADOPT_LEGACY=true on apply.
# Credential or endpoint rotation changes the target fingerprint. Set SM_PROVISION_MIGRATE_TARGET=true
# for a preview, review it, then apply with both migration and apply true within 15 minutes.
# Never use GC_TOKEN.
# GC_SM_URL e.g. https://synthetic-monitoring-api-<region>.grafana.net
GC_SM_URL=
GC_SM_TOKEN=
SM_PROVISION_APPLY=false
SM_PROVISION_ADOPT_LEGACY=false
SM_PROVISION_MIGRATE_TARGET=false

# ── Fleet Management (fake-collector registration via the FM connect API) ──
# Fleet metrics-only mode needs only a selected fleet_management declaration and the normal metrics
# sink. API registration is a separate mode requiring all three fields below; verify registration
# and fresh heartbeats independently. No GC_FM_* fields is an intentional metrics-only deployment.
# GC_FM_STACK_ID = FM basic-auth username = Grafana Cloud STACK ID (NOT GC_PROM_USER).
# GC_FM_URL e.g. https://fleet-management-prod-0NN.grafana.net ; GC_FM_TOKEN = CAP with fleet-management:write.
GC_FM_URL=
GC_FM_STACK_ID=
GC_FM_TOKEN=

# ── Agent Observability ingest (historically sigil; aiagent generation/conversation lane) ──
# Requires a selected ai_agent generation declaration plus the complete triplet below and a fresh
# Agent Observability delivery. Empty fields disable only this lane; gen_ai traces/metrics still use OTLP/Prometheus.
# GC_SIGIL_ENDPOINT e.g. https://sigil-prod-gb-south-1.grafana.net (base; /api/v1/...:export is appended).
# Auth is HTTP Basic base64(GC_SIGIL_TENANT_ID:GC_SIGIL_TOKEN). GC_SIGIL_TENANT_ID = the stack/tenant id
# (NOT GC_PROM_USER); GC_SIGIL_TOKEN = a CAP with the sigil ingest scope (NOT GC_TOKEN). Point GC_OTLP_*/
# GC_PROM_* at the SAME stack so the gen_ai traces+metrics correlate with the conversations.
GC_SIGIL_ENDPOINT=
GC_SIGIL_TENANT_ID=
GC_SIGIL_TOKEN=

# ── Container runtime hint (optional) ──
# Kubernetes sets KUBERNETES_SERVICE_HOST for every Pod, including containerd
# and CRI-O. Docker is detected via /.dockerenv. Leave both values empty unless
# another container runtime needs SYNTHKIT_IN_CONTAINER as an explicit hint.
SYNTHKIT_IN_CONTAINER=
KUBERNETES_SERVICE_HOST=
