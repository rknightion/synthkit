# Copy this file to .env, keep it private, and fill all seven ingest fields below.
# Put comments on their own lines. No token or numeric identifier belongs in this example.

# Verified published 1.6.3 image; no local build or blueprint override is needed.
SYNTHKIT_IMAGE_REF=ghcr.io/rknightion/synthkit@sha256:6c63a879bbc2af4921392f2dc95ce08a633e9edc09435c8e190c0da582f2730d
BLUEPRINT_NAMES=otlp-native,dbo11y-mysql
DRY_RUN=true
SYNTHKIT_BIND=127.0.0.1
SELFOBS_ENABLED=false

# One synthetic-data stack: the CAP token needs metrics:write, logs:write and traces:write.
# Each user is the matching positive numeric identifier, not a token or organisation ID.
GC_TOKEN=
GC_PROM_RW=
GC_PROM_USER=
GC_OTLP_ENDPOINT=
GC_OTLP_USER=
GC_LOKI=
GC_LOKI_USER=

# Optional registration and process telemetry stay disabled without their separate credentials.
