# Dockerfile.skcapture — multi-stage build for the skcapture inspector binary.
#
# Stage 1: build the static skcapture binary from source.
# Stage 2: minimal final image with kubectl on PATH (skcapture shells out to kubectl).
#
# Build:
#   docker build -f Dockerfile.skcapture -t skcapture:dev .
# Run (in-cluster):
#   deploy/skcapture/job.yaml  (recommended)
# Run (local kubeconfig):
#   docker run --rm -v ~/.kube:/root/.kube -v /tmp/out:/out \
#     skcapture:dev --plain --out /out/capture.json

# ─── Stage 1: builder ────────────────────────────────────────────────────────
FROM golang:1.27.0@sha256:4013ae0f9e7994f8535c58c811f8f863fbed38b72e0d51e6592156f758d66146 AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /skcapture ./cmd/skcapture

# ─── Stage 2: final image ─────────────────────────────────────────────────────
# Alpine base + pinned kubectl binary. skcapture shells out to kubectl so it
# must be on PATH in the final image.
#
# Pinned kubectl version: update KUBECTL_VERSION when your cluster API server
# requires a newer minor version (keep within ±1 of your cluster version).
FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

ARG TARGETARCH
ARG KUBECTL_VERSION=1.37.0
# Verified against dl.k8s.io/release/v1.37.0/bin/linux/<arch>/kubectl.sha256.
ARG KUBECTL_CHECKSUM_AMD64=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f
ARG KUBECTL_CHECKSUM_ARM64=922df28df248cc00a9e025f947704f1d1482de64ece54cfe57e61f19eaf1eef3

# Upgrade base packages before installing tools so the pinned base cannot retain
# a fixed OpenSSL vulnerability. Match kubectl and the inspector to the target CPU.
RUN apk upgrade --no-cache && apk add --no-cache curl ca-certificates && \
    case "$TARGETARCH" in \
      amd64) checksum="$KUBECTL_CHECKSUM_AMD64" ;; \
      arm64) checksum="$KUBECTL_CHECKSUM_ARM64" ;; \
      *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl && \
    echo "${checksum}  /usr/local/bin/kubectl" | sha256sum -c - && \
    chmod +x /usr/local/bin/kubectl && \
    apk del curl

# Copy the skcapture binary from the builder stage.
COPY --from=builder /skcapture /usr/local/bin/skcapture

# Run as a non-root user.
RUN addgroup -S -g 10001 skcapture && adduser -S -D -H -u 10001 -G skcapture skcapture
USER skcapture

ENTRYPOINT ["/usr/local/bin/skcapture"]
