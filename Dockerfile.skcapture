# Dockerfile.skcapture — multi-stage build for the skcapture inspector binary.
#
# Build skcapture and kubectl from source with the patched Go toolchain.
# Final stage: minimal image with kubectl on PATH (skcapture shells out to kubectl).
#
# Build:
#   docker build -f Dockerfile.skcapture -t skcapture:dev .
# Run (in-cluster):
#   deploy/skcapture/job.yaml  (recommended)
# Run (local kubeconfig):
#   docker run --rm -v ~/.kube:/root/.kube -v /tmp/out:/out \
#     skcapture:dev --plain --out /out/capture.json

# ─── Stage 1: builder ────────────────────────────────────────────────────────
FROM golang:1.27.2@sha256:5bc7f572bbaa98885a3a1fd9c0aa76b59e3e14e8628bfc316bbfd0c701e4818c AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /skcapture ./cmd/skcapture

# ─── kubectl builder ─────────────────────────────────────────────────────────
# The upstream v1.37.1 binaries still use Go 1.26.8, affected by
# CVE-2026-78667 and CVE-2026-97031. Rebuild the checksum-pinned official
# source with Go 1.27.2; use its vendored dependencies without modifying them.
FROM golang:1.27.2@sha256:5bc7f572bbaa98885a3a1fd9c0aa76b59e3e14e8628bfc316bbfd0c701e4818c AS kubectl-builder

# Keep kubectl within ±1 minor of the cluster API server. Version and source
# checksum must be updated together; checksum from the sibling .sha256 URL.
ARG KUBECTL_VERSION=1.37.1
ARG KUBECTL_SOURCE_CHECKSUM=d58492a058ac7cb1db0829a9e12317024f48d4bcbf56344b32b11276f9bdc2cf
ADD --checksum=sha256:${KUBECTL_SOURCE_CHECKSUM} https://dl.k8s.io/release/v${KUBECTL_VERSION}/kubernetes-src.tar.gz /tmp/kubernetes-src.tar.gz
WORKDIR /kubectl-src
RUN tar -xzf /tmp/kubernetes-src.tar.gz -C /kubectl-src

ARG TARGETARCH
RUN case "$TARGETARCH" in amd64|arm64) ;; *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac && \
    flags="-s -w" && \
    for pkg in k8s.io/client-go/pkg/version k8s.io/component-base/version; do \
      flags="$flags -X ${pkg}.gitVersion=v${KUBECTL_VERSION} -X ${pkg}.gitMajor=${KUBECTL_VERSION%%.*} -X ${pkg}.gitMinor=$(echo "$KUBECTL_VERSION" | cut -d. -f2)"; \
    done && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} \
    go build -mod=vendor -trimpath -tags=selinux,notest,grpcnotrace \
      -ldflags="$flags" -o /kubectl ./cmd/kubectl

# ─── Final image ──────────────────────────────────────────────────────────────
# Alpine base + source-built kubectl. No compiler or source in the final image.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# Upgrade base packages so the pinned base cannot retain a fixed vulnerability.
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates
COPY --from=kubectl-builder /kubectl /usr/local/bin/kubectl

# Copy the skcapture binary from the builder stage.
COPY --from=builder /skcapture /usr/local/bin/skcapture

# Run as a non-root user.
RUN addgroup -S -g 10001 skcapture && adduser -S -D -H -u 10001 -G skcapture skcapture
USER skcapture

ENTRYPOINT ["/usr/local/bin/skcapture"]
